<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>ContextCompiler.Security.Modules.Guards.Artifacts</PackageId>
        <Description>ContextCompiler security guard module that scans output artifacts for security threats before deployment.</Description>
        <IsPackable>true</IsPackable>
        <Configurations>Debug;Release;DebugLocal</Configurations>
        <Title>Artifacts Security Guard module</Title>
        <PackageTags>context;compiler;module;security;guard;artifacts;skills;scan;threats</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\..\Core\ContextCompiler.Modules.Abstractions\ContextCompiler.Modules.Abstractions.csproj" />
        <ProjectReference Include="..\..\..\..\Core\ContextCompiler.Core\ContextCompiler.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>
</Project>
