<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<PackageId>ContextCompiler.Agents.Modules.Copilot</PackageId>
	<Description>ContextCompiler agent configuration module for GitHub Copilot.</Description>
	<IsPackable>true</IsPackable>
	<Configurations>Debug;Release;DebugLocal</Configurations>
	<Title>GitHub Copilot agent module</Title>
	<PackageTags>context;compiler;module;agent;copilot;github</PackageTags>
	<PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="..\..\..\..\Core\ContextCompiler.Abstractions\ContextCompiler.Abstractions.csproj" />
	<ProjectReference Include="..\..\..\..\Core\ContextCompiler.Modules.Abstractions\ContextCompiler.Modules.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
	<None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
