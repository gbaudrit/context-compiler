{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-compiler.local/schemas/module.connectors.git/ctxc.config.schema.json",
  "title": "Context Compiler Git connector module configuration",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "moduleOptions": {
      "type": "object",
      "properties": {
        "connectors.git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repositories": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/repository"
              }
            }
          },
          "required": [ "repositories" ]
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "id", "repository" ],
      "properties": {
        "id": { "type": "string" },
        "repository": {
          "type": "string",
          "description": "Git repository as owner/name for GitHub-compatible shorthand or as absolute git URL."
        },
        "branch": { "type": "string" },
        "wiki": { "type": "boolean", "default": false },
        "target": {
          "type": "string",
          "description": "Workspace-relative clone target. Defaults to .external/git/<owner>/<repo>[.wiki]."
        },
        "refresh": { "type": "boolean", "default": false },
        "depth": {
          "type": "integer",
          "minimum": 1
        },
        "includes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "excludes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
