<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;DebugLocal</Configurations>
		<IsPackable>true</IsPackable>
		<PackageId>ContextCompiler.Views.Packs.Standard</PackageId>
		<Title>Standard views pack</Title>
		<Description>Standard views pack with the core views and JSON index view modules.</Description>
		<PackageTags>context;compiler;pack;views;json;index;projection;rendering;standard</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Authors>ContextCompiler</Authors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\ContextCompiler.Views\ContextCompiler.Views.csproj" />
	  <ProjectReference Include="..\..\Modules\ContextCompiler.Views.Modules.View.Index.Json\ContextCompiler.Views.Modules.View.Index.Json.csproj" />
	</ItemGroup>

</Project>
