<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;DebugLocal</Configurations>
		<IsPackable>true</IsPackable>
		<PackageId>ContextCompiler.Prompting.Blueprints.DotNet.WebApp.Razor</PackageId>
		<Title>Razor web app blueprint</Title>
		<Description>Blueprint for building a .NET Razor web app context with the standard packs, .NET engineering, developer persona, and Scriban rendering.</Description>
		<PackageTags>context;compiler;blueprint;dotnet;aspnetcore;razor;webapp;starter;scriban</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Authors>ContextCompiler</Authors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
		<ProjectReference Include="..\..\..\..\Packs\ContextCompiler.Packs.Starter.Standard\ContextCompiler.Packs.Starter.Standard.csproj" />
		<ProjectReference Include="..\..\Modules\ContextCompiler.Prompting.Modules.Engineering.DotNet\ContextCompiler.Prompting.Modules.Engineering.DotNet.csproj" />
		<ProjectReference Include="..\..\Modules\ContextCompiler.Prompting.Modules.Personas.Developers.DotNet\ContextCompiler.Prompting.Modules.Personas.Developers.DotNet.csproj" />
		<ProjectReference Include="..\..\Modules\ContextCompiler.Prompting.Modules.Templates.Scriban\ContextCompiler.Prompting.Modules.Templates.Scriban.csproj" />
	</ItemGroup>

</Project>
