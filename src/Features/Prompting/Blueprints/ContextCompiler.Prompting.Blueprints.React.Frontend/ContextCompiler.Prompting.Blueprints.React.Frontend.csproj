<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;DebugLocal</Configurations>
		<IsPackable>true</IsPackable>
		<PackageId>ContextCompiler.Prompting.Blueprints.React.Frontend</PackageId>
		<Title>React Frontend blueprint</Title>
		<Description>Comprehensive blueprint for building modern, production-ready React applications with TypeScript, state management, routing, API integration, and best practices.</Description>
		<PackageTags>react;frontend;spa;typescript;hooks;redux;router;components;ui;web;javascript</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Authors>ContextCompiler</Authors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
		<ProjectReference Include="..\..\..\..\Core\ContextCompiler.Modules.Abstractions\ContextCompiler.Modules.Abstractions.csproj" />
		<ProjectReference Include="..\..\Modules\ContextCompiler.Prompting.Modules.Personas.Developers.React\ContextCompiler.Prompting.Modules.Personas.Developers.React.csproj" />
	</ItemGroup>

</Project>
