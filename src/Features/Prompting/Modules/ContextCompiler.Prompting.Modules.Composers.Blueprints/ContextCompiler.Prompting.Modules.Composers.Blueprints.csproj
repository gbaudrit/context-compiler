<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;DebugLocal</Configurations>
		<IsPackable>true</IsPackable>
		<PackageId>ContextCompiler.Prompting.Modules.Composers.Blueprints</PackageId>
		<Description>
			Module de composition des blueprints pour le prompt. Extrait et structure les blueprints depuis la configuration ou les modules pour les intégrer dans le prompt final.
		</Description>
		<Authors>ContextCompiler</Authors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\..\..\..\Core\ContextCompiler.Abstractions\ContextCompiler.Abstractions.csproj" />
		<ProjectReference Include="..\..\..\..\..\..\Core\ContextCompiler.Modules.Abstractions\ContextCompiler.Modules.Abstractions.csproj" />
		<ProjectReference Include="..\..\ContextCompiler.Prompting.Abstractions\ContextCompiler.Prompting.Abstractions.csproj" />
	</ItemGroup>
</Project>
