<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>ContextCompiler.Skills.Modules.Providers.Anthropic</PackageId>
    <Description>ContextCompiler skill provider module for the anthropics/skills repository.</Description>
    <IsPackable>true</IsPackable>
    <Configurations>Debug;Release;DebugLocal</Configurations>
    <Title>Anthropic skills provider module</Title>
    <PackageTags>context;compiler;module;skills;anthropic;provider</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Core\ContextCompiler.Modules.Abstractions\ContextCompiler.Modules.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
