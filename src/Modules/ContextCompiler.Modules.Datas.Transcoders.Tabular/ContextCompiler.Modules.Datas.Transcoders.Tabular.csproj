<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>ContextCompiler.Modules.Datas.Transcoders.Tabular</PackageId>
    <Description>ContextCompiler transcoder module for tabular data shapes (tables, structured data).</Description>
    <IsPackable>true</IsPackable>
    <Configurations>Debug;Release;DebugLocal</Configurations>
    <Title>Tabular Data Transcoder Module</Title>
    <PackageTags>context;compiler;module;transcoder;tabular;data;json</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\ContextCompiler.Modules.Abstractions\ContextCompiler.Modules.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
