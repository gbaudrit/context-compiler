<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Métadonnées NuGet -->
		<PackageId>ContextCompiler.Modules.Artifacts.Writer</PackageId>

		<Description>
			Module d'écriture d'artéfacts pour ContextCompiler. Fournit des modules pour l'écriture d'artéfacts de sortie dans le système de fichiers et la création d'artéfacts de vue.
		</Description>

		<!-- Active la génération du package -->
		<IsPackable>true</IsPackable>
		<Configurations>Debug;Release;DebugLocal</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Core\ContextCompiler.Abstractions\ContextCompiler.Abstractions.csproj" />
		<ProjectReference Include="..\ContextCompiler.Modules.Abstractions\ContextCompiler.Modules.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>
</Project>
