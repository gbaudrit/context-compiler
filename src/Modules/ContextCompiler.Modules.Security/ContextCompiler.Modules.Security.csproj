<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Métadonnées NuGet -->
		<PackageId>ContextCompiler.Modules.Security</PackageId>

		<Description>
			Module de sécurité pour ContextCompiler. Fournit des gardes de sécurité (prompt injection, sensibilité des données, scope) et génère des rapports détaillés sur les résultats des analyses de sécurité effectuées par le Guardian.
		</Description>

		<!-- Active la génération du package -->
		<IsPackable>true</IsPackable>
		<Configurations>Debug;Release;DebugLocal</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Core\ContextCompiler.Modules.Abstractions\ContextCompiler.Modules.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
	</ItemGroup>
</Project>
