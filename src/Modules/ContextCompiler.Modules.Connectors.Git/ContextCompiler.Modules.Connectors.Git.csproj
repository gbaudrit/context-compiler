<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>ContextCompiler.Modules.Connectors.Git</PackageId>
    <Description>ContextCompiler module that clones Git repositories into the workspace before compilation.</Description>
    <IsPackable>true</IsPackable>
    <Configurations>Debug;Release;DebugLocal</Configurations>
    <Title>Git fetcher module</Title>
    <PackageTags>context;compiler;module;fetcher;git</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\ContextCompiler.Modules.Abstractions\ContextCompiler.Modules.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="schemas\ctxc.config.schema.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="schemas\ctxc.config.schema.json">
      <PackagePath>contentFiles/any/schemas/ctxc.config.schema.json</PackagePath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
