<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;DebugLocal</Configurations>
    <IsPackable>true</IsPackable>
    <PackageId>ContextCompiler.Modules.Commands.Registry</PackageId>
    <Description>Génère un index au format json des commandes exposées par le contexte.</Description>
    <Authors>ContextCompiler</Authors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\ContextCompiler.Abstractions\ContextCompiler.Abstractions.csproj" />
    <ProjectReference Include="..\ContextCompiler.Modules.Abstractions\ContextCompiler.Modules.Abstractions.csproj" />
  </ItemGroup>

</Project>
