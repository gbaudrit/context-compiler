<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Métadonnées NuGet -->
		<PackageId>ContextCompiler.Modules.Personas.Index</PackageId>

		<Description>
			Module d'index des personas pour ContextCompiler. Génère un artéfact JSON listant les personas activés et leurs résultats, facilitant le suivi et l'analyse des personas utilisés dans le processus de compilation de contexte.
		</Description>

		<!-- Active la génération du package -->
		<IsPackable>true</IsPackable>
		<Configurations>Debug;Release;DebugLocal</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Core\ContextCompiler.Abstractions\ContextCompiler.Abstractions.csproj" />
		<ProjectReference Include="..\ContextCompiler.Modules.Abstractions\ContextCompiler.Modules.Abstractions.csproj" />
	</ItemGroup>
</Project>
