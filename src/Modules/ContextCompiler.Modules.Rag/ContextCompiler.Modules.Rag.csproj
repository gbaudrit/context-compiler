<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;DebugLocal</Configurations>
		<PackageId>ContextCompiler.Modules.Rag</PackageId>
		<Description>Ajoute des capacités RAG locales au Context Compiler.</Description>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Core\ContextCompiler.Modules.Abstractions\ContextCompiler.Modules.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!--<PackageReference Include="FastBertTokenizer" />-->
		<PackageReference Include="Microsoft.Bcl.Memory" />
		<PackageReference Include="Microsoft.ML.Tokenizers" />
		<PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" />
		<PackageReference Include="SmartComponents.LocalEmbeddings" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="onnx\all-MiniLM-L6-v2.onnx">
			<PackagePath>content/all-MiniLM-L6-v2.onnx</PackagePath>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="onnx\all-MiniLM-L6-v2_vocab.txt">
			<PackagePath>content/all-MiniLM-L6-v2_vocab.txt</PackagePath>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
