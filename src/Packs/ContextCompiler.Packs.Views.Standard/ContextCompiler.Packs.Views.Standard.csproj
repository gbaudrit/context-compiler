<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;DebugLocal</Configurations>
		<IsPackable>true</IsPackable>
		<PackageId>ContextCompiler.Packs.Views.Standard</PackageId>
		<Description>Pack officiel de views par defaut. Regroupe les modules de vues recommandes pour la description et l'index JSON.</Description>
		<Authors>ContextCompiler</Authors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Modules\ContextCompiler.Modules.Views\ContextCompiler.Modules.Views.csproj" />
		<ProjectReference Include="..\..\Modules\ContextCompiler.Modules.Views.View.Index.Json\ContextCompiler.Modules.Views.View.Index.Json.csproj" />
	</ItemGroup>

</Project>
