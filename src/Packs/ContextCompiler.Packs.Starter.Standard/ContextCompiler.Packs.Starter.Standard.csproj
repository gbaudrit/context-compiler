<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;DebugLocal</Configurations>
		<IsPackable>true</IsPackable>
		<PackageId>ContextCompiler.Packs.Starter.Standard</PackageId>
		<Title>Standard starter pack</Title>
		<Description>Standard starter pack combining readers, prompt, views, and artifacts packs.</Description>
		<PackageTags>context;compiler;pack;starter;bundle;readers;prompt;views;artifacts;standard</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Authors>ContextCompiler</Authors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
		<ProjectReference Include="..\..\Features\Output\Packs\ContextCompiler.Output.Packs.Standard\ContextCompiler.Output.Packs.Standard.csproj" />
		<ProjectReference Include="..\..\Features\Security\Packs\ContextCompiler.Security.Packs.Standard\ContextCompiler.Security.Packs.Standard.csproj" />
		<ProjectReference Include="..\..\Features\Views\Packs\ContextCompiler.Views.Packs.Standard\ContextCompiler.Views.Packs.Standard.csproj" />
		<ProjectReference Include="..\ContextCompiler.Packs.Datas.Transcoders.Standard\ContextCompiler.Packs.Datas.Transcoders.Standard.csproj" />
		<ProjectReference Include="..\..\Features\Readers\Packs\ContextCompiler.Readers.Packs.Standard\ContextCompiler.Readers.Packs.Standard.csproj" />
		<ProjectReference Include="..\..\Features\Prompting\Packs\ContextCompiler.Prompting.Packs.Standard\ContextCompiler.Prompting.Packs.Standard.csproj" />
	</ItemGroup>

</Project>
