<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;DebugLocal</Configurations>
		<IsPackable>true</IsPackable>
		<PackageId>ContextCompiler.Packs.Starter.Standard</PackageId>
		<Title>Standard starter pack</Title>
		<Description>Standard starter pack combining readers, prompt, views, and artifacts packs.</Description>
		<PackageTags>context;compiler;pack;starter;bundle;readers;prompt;views;artifacts;standard</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Authors>ContextCompiler</Authors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'DebugLocal'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
		<ProjectReference Include="..\ContextCompiler.Packs.Artifacts.Standard\ContextCompiler.Packs.Artifacts.Standard.csproj" />
		<ProjectReference Include="..\ContextCompiler.Packs.Prompt.Standard\ContextCompiler.Packs.Prompt.Standard.csproj" />
		<ProjectReference Include="..\ContextCompiler.Packs.Readers.Standard\ContextCompiler.Packs.Readers.Standard.csproj" />
		<ProjectReference Include="..\ContextCompiler.Packs.Views.Standard\ContextCompiler.Packs.Views.Standard.csproj" />
	</ItemGroup>

</Project>
