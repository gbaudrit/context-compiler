{
  "name": "vscode-ctxc",
  "displayName": "CtxC (Context Compiler)",
  "description": "Phase 1 integration for Context-Compiler: compile workspace context and browse views.",
  "version": "0.1.0",
  "publisher": "your-org",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "ctxc-view-select",
        "fullName": "Ctxc select view",
        "name": "ctxc-view-select",
        "description": "Select a view in CtxC views tree to use as context for the current chat session."
      }
    ],
    "commands": [
      {
        "command": "ctxc.compileWorkspace",
        "title": "CtxC: Compile Context (Workspace)"
      },
      {
        "command": "ctxc.compileFolder",
        "title": "CtxC: Compile Context (Folder\u2026)"
      },
      {
        "command": "ctxc.selectView",
        "title": "CtxC: Select View"
      },
      {
        "command": "ctxc.selectPersona",
        "title": "CtxC: Select Persona"
      },
      {
        "command": "ctxc.openOutputs",
        "title": "Open Compiled Output"
      },
      {
        "command": "ctxc.copyActiveViewPrompt",
        "title": "Copy View + Framing to Clipboard"
      },
      {
        "command": "ctxc.recompileLast",
        "title": "Re-Compile (Last Run)"
      },
      {
        "command": "ctxc.setActiveViewFromTree",
        "title": "Set Active View"
      },
      {
        "command": "ctxc.openPersonaFramingFromTree",
        "title": "Open Persona Framing"
      },
      {
        "command": "ctxc.setActivePersonaFromTree",
        "title": "Set Active Persona"
      },
      {
        "command": "ctxc.executeCommandFromTree",
        "title": "Execute Command"
      },
      {
        "command": "ctxc.copyCommandFromTree",
        "title": "Copy Command"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "ctxcViews",
          "name": "CtxC Views",
          "icon": "debug-configure"
        },
        {
          "id": "ctxcPersonas",
          "name": "CtxC Personas",
          "icon": "account"
        },
        {
          "id": "ctxcCommands",
          "name": "CtxC Commands",
          "icon": "terminal"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "ctxc.setActiveViewFromTree",
          "when": "view == ctxcViews && viewItem == ctxcView",
          "group": "navigation"
        },
        {
          "command": "ctxc.openPersonaFramingFromTree",
          "when": "view == ctxcPersonas && viewItem == ctxcPersona",
          "group": "navigation"
        },
        {
          "command": "ctxc.setActivePersonaFromTree",
          "when": "view == ctxcPersonas && viewItem == ctxcPersona",
          "group": "navigation"
        },
        {
          "command": "ctxc.executeCommandFromTree",
          "when": "view == ctxcCommands && viewItem == ctxcCommand",
          "group": "navigation"
        },
        {
          "command": "ctxc.copyCommandFromTree",
          "when": "view == ctxcCommands && viewItem == ctxcCommand",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "CtxC",
      "properties": {
        "ctxc.path": {
          "type": "string",
          "default": "ContextCompiler.Host.Cli.exe",
          "description": "Path to the ctxc CLI executable."
        },
        "ctxc.modulesPath": {
          "type": "string",
          "default": "ContextCompiler.Modules.Cli.exe",
          "description": "Path to the ctxc modules CLI executable."
        },
        "ctxc.configPath": {
          "type": "string",
          "default": "ctxc.config.json",
          "description": "Path (relative to workspace root) to ctxc config file."
        },
        "ctxc.outputDir": {
          "type": "string",
          "default": ".ctxc/compiled",
          "description": "Output directory for compiled artifacts."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/node": "^22",
		"@types/vscode": "^1.100.0",
		"eslint": "^9.13.0",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.0"
  }
}