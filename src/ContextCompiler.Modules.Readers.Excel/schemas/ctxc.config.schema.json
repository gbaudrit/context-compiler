{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-compiler.local/schemas/module.readers.excel/ctxc.config.schema.json",
  "title": "Context Compiler Excel module configuration",
  "type": "object",
  "description": "Excel-based extract configuration.",
  "required": [ "id", "label" ],
  "additionalProperties": false,
  "$defs": {
    "moduleOptions": {
      "type": "object",
      "properties": {
        "excel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extracts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/extract"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "extract": {
      "type": "object",
      "description": "Excel-based extract configuration.",
      "required": [ "id", "label" ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "sheet": { "type": "string" },
        "table": { "type": "string" },
        "skip": {
          "type": "integer",
          "minimum": 0
        },
        "headerRowIndex": {
          "type": "integer",
          "minimum": 0
        },
        "select": {
          "type": "array",
          "items": { "type": "string" }
        },
        "where": {
          "type": "array",
          "items": { "$ref": "#/$defs/excelWhere" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "excelWhere": {
      "type": "object",
      "required": [ "col", "op" ],
      "additionalProperties": false,
      "properties": {
        "col": { "type": "string" },
        "op": {
          "type": "string",
          "enum": [ "eq", "ne", "in", "regex" ]
        },
        "value": {}
      }
    }
  }
}
