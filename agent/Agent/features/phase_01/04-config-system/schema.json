{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-compiler.local/schemas/ctxc.config.schema.json",
  "title": "Context Compiler Configuration",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            },
            "audience": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "must": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mustNot": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "glossary": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "outputContract": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "personas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "mode": {
          "type": "string",
          "enum": [
            "append",
            "prepend",
            "replace"
          ],
          "default": "append"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          },
          "default": {}
        }
      },
      "required": [
        "active"
      ]
    },
    "excel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRows": {
              "type": "integer",
              "minimum": 1,
              "default": 2000
            },
            "trimCells": {
              "type": "boolean",
              "default": true
            },
            "emptyRowPolicy": {
              "type": "string",
              "enum": [
                "skip",
                "keep"
              ],
              "default": "skip"
            },
            "header": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "firstRow",
                    "explicit"
                  ],
                  "default": "firstRow"
                },
                "normalize": {
                  "type": "boolean",
                  "default": true
                }
              }
            }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "match": {
                "type": "string",
                "minLength": 1
              },
              "extracts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sheet": {
                      "type": "string",
                      "minLength": 1
                    },
                    "table": {
                      "type": "string",
                      "minLength": 1
                    },
                    "range": {
                      "type": "string",
                      "minLength": 3
                    },
                    "headerRow": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "select": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "exclude": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "rename": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "where": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "col": {
                            "type": "string",
                            "minLength": 1
                          },
                          "op": {
                            "type": "string",
                            "enum": [
                              "eq",
                              "in",
                              "contains",
                              "gt",
                              "lt",
                              "gte",
                              "lte"
                            ]
                          },
                          "value": {}
                        },
                        "required": [
                          "col",
                          "op",
                          "value"
                        ]
                      }
                    },
                    "fragmenting": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "mode": {
                          "type": "string",
                          "enum": [
                            "single",
                            "chunks",
                            "groupBy",
                            "rowWise"
                          ],
                          "default": "single"
                        },
                        "maxRows": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "by": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "mode"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "sheet"
                  ],
                  "allOf": [
                    {
                      "oneOf": [
                        {
                          "required": [
                            "table"
                          ],
                          "not": {
                            "required": [
                              "range"
                            ]
                          }
                        },
                        {
                          "required": [
                            "range"
                          ],
                          "not": {
                            "required": [
                              "table"
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "match",
              "extracts"
            ]
          }
        }
      }
    }
  }
}