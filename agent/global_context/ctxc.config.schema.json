{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "context": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "project": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            },
            "audience": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "object",
          "properties": {
            "must": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mustNot": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "glossary": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "outputContract": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string"
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "style": {
              "type": "object",
              "properties": {
                "tone": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}