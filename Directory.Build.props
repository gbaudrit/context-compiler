<Project>
	<PropertyGroup>
		<VersionPrefix>0.1.0</VersionPrefix>
		<VersionSuffix>alpha.1</VersionSuffix>

		<Authors>Guillaume Baudrit</Authors>
		<Company>Guillaume Baudrit</Company>
		<Copyright>Copyright 2026 Guillaume Baudrit</Copyright>
		<RepositoryUrl>https://github.com/gbaudrit/context-compiler</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/gbaudrit/context-compiler</PackageProjectUrl>
		<PackageTags>context;compiler;pipeline;llm;pre-llm;deterministic;ir;modular</PackageTags>
		
		<!-- Target framework -->
		<TargetFramework>net10.0</TargetFramework>

		<!-- Modern defaults -->
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<Deterministic>true</Deterministic>
		<LangVersion>preview</LangVersion>

		<!-- Analyzers -->
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

		<!-- Central Package Management -->
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>

		<!-- NuGet packing defaults -->
		<RepositoryType>git</RepositoryType>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>

		<!-- Si tu veux inclure pdb dans le .nupkg (comme ton nuspec) -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>
			$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb;.xml
		</AllowedOutputExtensionsInPackageBuildOutputFolder>

		<!-- Recommandé pour éviter des comportements de pack implicites -->
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		

		<!-- sort le nupkg dans bin\DebugLocal\... -->
		<PackageOutputPath>$(OutputPath)</PackageOutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IsTestProject)' == 'true'">
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'DebugLocal' And '$(IsPackable)' == 'true'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>
</Project>
