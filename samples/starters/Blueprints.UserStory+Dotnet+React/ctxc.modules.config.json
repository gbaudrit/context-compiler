        "ContextCompiler.Blueprints.*"
      ],
      "blockedPackageIds": []
    },
    "packages": {
      "ContextCompiler.Packs.Starter.Standard@locale":"0.1.0-alpha.1",
      "ContextCompiler.Blueprints.Agile.UserStory@locale":"0.1.0-alpha.1",
      "ContextCompiler.Blueprints.DotNet.Api.Backend@locale":"0.1.0-alpha.1",
      "ContextCompiler.Blueprints.React.Frontend@locale":"0.1.0-alpha.1",
      "ContextCompiler.Modules.Prompt.Templates.Scriban@locale":"0.1.0-alpha.1"
    }
