{
    "mode": "Install",
    "installRoot": ".ctxc/modules",
    "lockFile": ".ctxc/ctxc.modules.lock.json",
    "offline": false,
    "quarantineRoot": ".ctxc/quarantine",
    "sources": [
      {
        "name": "locale",
        "url": "C:\\.localenugetsource",
        "trusted": true,
        "provider": "nuget"
      },
      {
        "name": "nuget.org",
        "url": "https://api.nuget.org/v3/index.json",
        "trusted": true,
        "provider": "nuget"
       }
    ],
    "trust": {
      "requireTrustedSource": true,
      "requireSignedPackages": false,
      "allowedPackageIds": [
        "ContextCompiler.*"
      ],
      "blockedPackageIds": []
    },
    "packages": {
      "ContextCompiler.Packs.Starter.Standard@locale":"0.1.0-alpha.1",
      "ContextCompiler.Prompting@locale": "0.1.0-alpha.1",
      "ContextCompiler.Prompting.Modules.Templates.Scriban@locale": "0.1.0-alpha.1",
      "ContextCompiler.Readers.Modules.Eml@locale": "0.1.0-alpha.1",
      "ContextCompiler.Reports.Modules.Pipelines.Mermaid@locale": "0.1.0-alpha.1"
    }
  }
