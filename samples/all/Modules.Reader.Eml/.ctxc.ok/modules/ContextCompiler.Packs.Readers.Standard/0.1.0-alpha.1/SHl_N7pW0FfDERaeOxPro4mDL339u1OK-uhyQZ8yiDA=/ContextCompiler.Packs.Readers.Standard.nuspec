<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ContextCompiler.Packs.Readers.Standard</id>
    <version>0.1.0-alpha.1</version>
    <title>Standard readers pack</title>
    <authors>ContextCompiler</authors>
    <readme>README.md</readme>
    <projectUrl>https://github.com/gbaudrit/context-compiler</projectUrl>
    <description>Standard readers pack for the most common supported input formats.</description>
    <copyright>Copyright 2026 Guillaume Baudrit</copyright>
    <tags>context compiler pack readers input markdown yaml excel pdf standard</tags>
    <repository type="git" url="https://github.com/gbaudrit/context-compiler" commit="7e58ec1ddd762b6741eae471ab0d1ad685897e39" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="ContextCompiler.Modules.Readers.Excel" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Modules.Readers.Markdown" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Modules.Readers.Pdf" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Modules.Readers.Text" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Modules.Readers.Yaml" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ClosedXML" version="0.104.2" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.3" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Logging.Abstractions" version="10.0.3" exclude="Build,Analyzers" />
        <dependency id="PdfPig" version="0.1.13" exclude="Build,Analyzers" />
        <dependency id="Tabula" version="0.1.5" exclude="Build,Analyzers" />
        <dependency id="Tabula.Json" version="0.1.5" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>