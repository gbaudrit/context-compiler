<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ContextCompiler.Packs.Prompt.Standard</id>
    <version>0.1.0-alpha.1</version>
    <title>Standard prompt pack</title>
    <authors>ContextCompiler</authors>
    <readme>README.md</readme>
    <projectUrl>https://github.com/gbaudrit/context-compiler</projectUrl>
    <description>Standard prompt pack with the recommended prompt composer modules.</description>
    <copyright>Copyright 2026 Guillaume Baudrit</copyright>
    <tags>context compiler pack prompt composers generation templates standard</tags>
    <repository type="git" url="https://github.com/gbaudrit/context-compiler" commit="a5a6c0748fce02413d80f268d57e7c1a13035bf2" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="ContextCompiler.Modules.Prompt.Composers.Assumptions" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Modules.Prompt.Composers.Audiences" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Modules.Prompt.Composers.Constraints" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Modules.Prompt.Composers.General" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Modules.Prompt.Composers.Glossary" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Modules.Prompt.Composers.Objectives" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Modules.Prompt.Composers.Views" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.3" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Logging.Abstractions" version="10.0.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>