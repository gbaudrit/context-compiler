<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ContextCompiler.Packs.Starter.Standard</id>
    <version>0.1.0-alpha.1</version>
    <title>Standard starter pack</title>
    <authors>ContextCompiler</authors>
    <readme>README.md</readme>
    <projectUrl>https://github.com/gbaudrit/context-compiler</projectUrl>
    <description>Standard starter pack combining input ingestion, readers, prompting, views, security, and output packs.</description>
    <copyright>Copyright 2026 Guillaume Baudrit</copyright>
    <tags>context compiler pack starter bundle input-ingestion readers prompting views security output standard</tags>
    <repository type="git" url="https://github.com/gbaudrit/context-compiler" commit="7aaf8f78796651e9c9c22bd58c86eccc99ad44df" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="ContextCompiler.InputIngestion.Packs.Transcoders.Standard" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Output.Packs.Standard" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Prompting.Packs.Standard" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Readers.Packs.Standard" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Security.Packs.Standard" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Views.Packs.Standard" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ClosedXML" version="0.104.2" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.3" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.FileSystemGlobbing" version="10.0.3" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Logging.Abstractions" version="10.0.3" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Options" version="10.0.3" exclude="Build,Analyzers" />
        <dependency id="ModelContextProtocol" version="1.1.0" exclude="Build,Analyzers" />
        <dependency id="PdfPig" version="0.1.13" exclude="Build,Analyzers" />
        <dependency id="Tabula" version="0.1.5" exclude="Build,Analyzers" />
        <dependency id="Tabula.Json" version="0.1.5" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>