<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Tabula.Json</id>
    <version>0.1.5</version>
    <authors>BobLd</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/BobLd/tabula-sharp</projectUrl>
    <description>Extract tables from PDF files (port of tabula-java using PdfPig). Json writer.</description>
    <tags>pdf, extract, table, tabula, pdfpig, parse, extraction, json, export</tags>
    <repository type="git" url="https://github.com/BobLd/tabula-sharp" commit="ee484e7947133faf83a24a0aa5f5c1db75626c67" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="Tabula" version="0.1.5" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.7.1">
        <dependency id="Tabula" version="0.1.5" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0">
        <dependency id="Tabula" version="0.1.5" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Tabula" version="0.1.5" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Tabula" version="0.1.5" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>