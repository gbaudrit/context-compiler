<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ContextCompiler.Security.Packs.Standard</id>
    <version>0.1.0-alpha.1</version>
    <title>Standard security pack</title>
    <authors>ContextCompiler</authors>
    <readme>README.md</readme>
    <projectUrl>https://github.com/gbaudrit/context-compiler</projectUrl>
    <description>Standard security pack with the core security module, email guard module, and data part filtering guard.</description>
    <copyright>Copyright 2026 Guillaume Baudrit</copyright>
    <tags>context compiler pack security guards email datapart filter redaction obfuscation standard</tags>
    <repository type="git" url="https://github.com/gbaudrit/context-compiler" commit="7aaf8f78796651e9c9c22bd58c86eccc99ad44df" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="ContextCompiler.Modules.Abstractions" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Security" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Security.Modules.Guards.DataPart" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="ContextCompiler.Security.Modules.Guards.Email" version="0.1.0-alpha.1" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.3" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.FileSystemGlobbing" version="10.0.3" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Logging.Abstractions" version="10.0.3" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Options" version="10.0.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>