{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-compiler.local/schemas/ctxc.config.schema.json",
  "title": "Context Compiler Configuration",
  "type": "object",
  "required": [
    "context",
    "personas",
    "files",
    "views"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "context": {
      "type": "object",
      "required": [
        "enabled",
        "name",
        "summary",
        "domain",
        "audiences",
        "objectives",
        "assumptions",
        "constraints",
        "glossary"
      ],
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audiences": {
          "type": "object",
          "description": "Audience keys to hints or notes.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "object",
          "required": [
            "canUseExternalSources",
            "must",
            "mustNot"
          ],
          "additionalProperties": false,
          "properties": {
            "canUseExternalSources": {
              "type": "boolean"
            },
            "must": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mustNot": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "domain": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "glossary": {
          "type": "object",
          "description": "Key/value glossary entries.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "personas": {
      "type": "object",
      "required": [
        "active",
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "append",
            "replace"
          ]
        },
        "params": {
          "type": "object",
          "description": "Per-persona configuration maps.",
          "additionalProperties": {
            "$ref": "#/$defs/personaParams"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "description": "File selection \u002B independent plugin options.",
        "additionalProperties": false,
        "properties": {
          "includes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Explicit file paths to include."
          },
          "match": {
            "type": "string",
            "description": "Glob-like pattern to match files (e.g., tools/UBL-Invoice-*.yaml)."
          },
          "options": {
            "$ref": "#/$defs/pluginOptions"
          }
        },
        "anyOf": [
          {
            "required": [
              "includes"
            ]
          },
          {
            "required": [
              "match"
            ]
          }
        ]
      }
    },
    "views": {
      "type": "object",
      "required": [
        "views"
      ],
      "additionalProperties": false,
      "properties": {
        "inline": {
          "type": "boolean",
          "default": false
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "select": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "personaParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {
              "type": "string"
            },
            "includeExamples": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "pluginOptions": {
      "type": "object",
      "description": "Independent plugin configuration container. Each plugin defines its own shapes.",
      "properties": {
            "excel": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "extracts": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/https___context_compiler_local_schemas_plugin_readers_excel_ctxc_config_schema_json/$defs/extract"
                  }
                }
              }
            },
            "pluginOptionsVariant": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "extracts": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/pluginOptionsVariant"
                  }
                }
              }
            }
          },
      "oneOf": [
          {"required": ["excel"]},
          {"required": ["pluginOptionsVariant"]}
      ],
      "additionalProperties": false
    },
    "pluginOptionsVariant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extracts": {
          "type": "array",
          "description": "Extraction directives for a specific plugin.",
          "items": {
            "oneOf": []
          }
        }
      }
    },
    "https___context_compiler_local_schemas_plugin_readers_excel_ctxc_config_schema_json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://context-compiler.local/schemas/plugin.readers.excel/ctxc.config.schema.json",
      "title": "Context Compiler Excel plugin configuration",
      "type": "object",
      "description": "Excel-based extract configuration.",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "$defs": {
        "pluginMeta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pluginKey": {
              "type": "string",
              "const": "excel"
            }
          },
          "required": [
            "pluginKey"
          ]
        },
        "pluginOptions": {
          "type": "object",
          "properties": {
            "excel": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "extracts": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/https___context_compiler_local_schemas_plugin_readers_excel_ctxc_config_schema_json/$defs/extract"
                  }
                }
              }
            }
          },
          "additionalProperties": false
        },
        "extract": {
          "type": "object",
          "description": "Excel-based extract configuration.",
          "required": [
            "id",
            "label"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "sheet": {
              "type": "string"
            },
            "table": {
              "type": "string"
            },
            "skip": {
              "type": "integer",
              "minimum": 0
            },
            "headerRowIndex": {
              "type": "integer",
              "minimum": 0
            },
            "select": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "where": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/https___context_compiler_local_schemas_plugin_readers_excel_ctxc_config_schema_json/$defs/excelWhere"
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "excelWhere": {
          "type": "object",
          "required": [
            "col",
            "op"
          ],
          "additionalProperties": false,
          "properties": {
            "col": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "eq",
                "ne",
                "in",
                "regex"
              ]
            },
            "value": {}
          }
        }
      }
    }
  },
  "$comment": "Generated by ctxc plugins restore. Aggregates core schema \u002B plugin schemas."
}